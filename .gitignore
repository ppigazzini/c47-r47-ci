# Maintainer-only dev surface (planning docs, bug reports, prompts): kept local,
# never committed to the harness history.
__DEV

# test harness output
/ci-artifacts/

# stray calculator state files (lanes run the testSuite in a scratch dir;
# these patterns are defence-in-depth so a stray run never dirties the repo)
*.REGS.TSV
*.bmp
/backup.cfg
/c47.sav

# Python bytecode from running the tooling helpers in place, and the dev
# environment `uv sync` builds for ruff/ty/pre-commit. uv.lock IS tracked:
# it pins the versions the hooks run, so a lint result is reproducible.
__pycache__/
*.pyc
.venv/
.ruff_cache/
