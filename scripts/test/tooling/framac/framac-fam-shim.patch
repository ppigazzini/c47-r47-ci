diff --git a/src/c47/solver/finite_differences.h b/src/c47/solver/finite_differences.h
index 8e69af70a..1735bc4f6 100644
--- a/src/c47/solver/finite_differences.h
+++ b/src/c47/solver/finite_differences.h
@@ -12,7 +12,11 @@ typedef struct {
     uint8_t n;      // Number of steps from the x, each step is by h in either direction
